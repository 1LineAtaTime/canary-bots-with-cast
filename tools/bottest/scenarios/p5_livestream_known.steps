# SCENARIO: p5_livestream_known   SEED: 0   CAMERAS: auto   BOTCFG: auto
# Run: runner.py p5_livestream_known.steps --profile wsl-up --var CASTER="Harness Caster"
# P5 (#160) V8 repro, NO bots needed: upstream's livestream forwards the caster's raw packets to every
# viewer, but a viewer joins with its own (empty) known-creature set. A creature the caster saw BEFORE
# the viewer joined, then left behind, is re-sent as "known" (id only) when it comes back into view,
# and OTClient drops the viewer: "server said that a creature is known, but it's not".
# Steps: the caster sees the creatures at the start spot, walks 19 tiles west (not through the north gate, which a bot crowd can block) (they leave the view but
# stay in the caster's known set), the viewer joins there, the caster walks back.
@p1 login char="$CASTER"
@p1 goto 32369,32220,7 range=2 stuck=20 timeout=150
@p1 say !livestream off
@p1 hold 2
@p1 view recent=5000
@p1 goto 32350,32221,7 range=3 stuck=20 timeout=150
@p1 hold 2
@p1 say !livestream on
@p1 hold 2
@cam:$CASTER login desc=@livestream pw=
@cam:$CASTER perceive reset=1
@p1 hold 3
@p1 goto 32369,32220,7 range=2 stuck=20 timeout=150
@p1 hold 4
@p1 say p5 known back
@p1 hold 4
@cam:$CASTER view recent=30000
@srv expect src=cli:c1 k=see_text text~="p5 known back" min=1 within=60
@srv expect-none src=cli:c1 k=game_end within=10
@p1 say !livestream off
@srv expect src=cli:c1 k=game_end min=1 within=40 wait=25
@p1 logout
