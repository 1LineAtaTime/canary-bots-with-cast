# SCENARIO: p5_v11c_client_login   SEED: 0   CAMERAS: auto   BOTCFG: off
# P5 (#160) V11c: the 15.25 client's REAL login path (OTClient 4.2 EnterGame HTTP login -> character
# list -> enter), against the disposable port DB only. Login endpoint: .work/port1525/p5/bin/p5_login.py
# (a stand-in for deployment/web/login.php, which needs MyAAC) on 127.0.0.1:8080.
# Run: runner.py p5_v11c_client_login.steps --profile wsl-port --visible --var GODPW=<test pw> --var BOTCAM=<bot>
# Per @god character: enter, inventory/equipment (self), game panels (uicheck), screenshot, local say, logout.
# Mago Pipi also sends a private message to a bot; High Player (logs in 6 tiles from Benjamin) opens Benjamin's trade window.
# Then the viewer lists: @cast (bots + casters) entering a bot, @livestream entering a live human caster.
@p1 uilogin acct=@god pw=$GODPW expect=Rookstayer
@p1 shot charlist_god
@p1 uichar Rookstayer
@p1 hold 4
@p1 self
@p1 uicheck expect=game_inventory=loaded
@p1 shot Rookstayer_ingame
@p1 say p5 v11c Rookstayer local
@srv expect src=cli:p1 k=see_text text~="p5 v11c Rookstayer local" min=1 within=30 optional=1
@p1 logout
@srv sleep 4
@p1 uilogin acct=@god pw=$GODPW expect=Rookstayer
@p1 uichar Mago Pipi
@p1 hold 4
@p1 self
@p1 uicheck expect=game_inventory=loaded
@p1 shot Mago_Pipi_ingame
@p1 say p5 v11c Mago_Pipi local
@p1 wait-see any-bot timeout=90 as=PMBOT
@p1 pm $PMBOT p5 v11c private hello
@srv expect src=cli:p1 k=see_msg text~="Message sent to $PMBOT" min=1 within=10
@p1 uicheck
@p1 shot Mago_Pipi_pm
@p1 hold 3
@srv expect src=cli:p1 k=see_text text~="p5 v11c Mago_Pipi local" min=1 within=30 optional=1
@p1 logout
@srv sleep 4
@p1 uilogin acct=@god pw=$GODPW expect=Rookstayer
@p1 uichar Powerhealz
@p1 hold 4
@p1 self
@p1 uicheck expect=game_inventory=loaded
@p1 shot Powerhealz_ingame
@p1 say p5 v11c Powerhealz local
@srv expect src=cli:p1 k=see_text text~="p5 v11c Powerhealz local" min=1 within=30 optional=1
@p1 logout
@srv sleep 4
@p1 uilogin acct=@god pw=$GODPW expect=Rookstayer
@p1 uichar High Player
@p1 hold 4
@p1 self
@p1 uicheck expect=game_inventory=loaded
@p1 shot High_Player_ingame
@p1 say p5 v11c High_Player local
@p1 goto 32348,32219,7 range=1 stuck=15 timeout=90
@p1 say hi
@p1 hold 3
@p1 say trade npc=1
@p1 hold 3
@srv expect src=cli:p1 k=npc_trade min=1 within=30
@p1 shot High_Player_npctrade_Benjamin
@p1 say bye npc=1
@srv expect src=cli:p1 k=see_text text~="p5 v11c High_Player local" min=1 within=30 optional=1
@p1 logout
@srv sleep 4
@p1 uilogin acct=@god pw=$GODPW expect=Rookstayer
@p1 uichar The Hulk
@p1 hold 4
@p1 self
@p1 uicheck expect=game_inventory=loaded
@p1 shot The_Hulk_ingame
@p1 say p5 v11c The_Hulk local
@srv expect src=cli:p1 k=see_text text~="p5 v11c The_Hulk local" min=1 within=30 optional=1
@p1 logout
@srv sleep 4
@p1 uilogin acct=@god pw=$GODPW expect=Rookstayer
@p1 uichar GOD
@p1 hold 4
@p1 self
@p1 uicheck expect=game_inventory=loaded
@p1 shot GOD_ingame
@p1 say p5 v11c GOD local
@srv expect src=cli:p1 k=see_text text~="p5 v11c GOD local" min=1 within=30 optional=1
@p1 logout
@srv sleep 4
@p1 uilogin acct=@god pw=$GODPW expect=Rookstayer
@p1 uichar Legolas
@p1 hold 4
@p1 self
@p1 uicheck expect=game_inventory=loaded
@p1 shot Legolas_ingame
@p1 say p5 v11c Legolas local
@srv expect src=cli:p1 k=see_text text~="p5 v11c Legolas local" min=1 within=30 optional=1
@p1 logout
@srv sleep 4
@p1 uilogin acct=@god pw=$GODPW expect=Rookstayer
@p1 uichar Knight Sample
@p1 hold 4
@p1 self
@p1 uicheck expect=game_inventory=loaded
@p1 shot Knight_Sample_ingame
@p1 say p5 v11c Knight_Sample local
@srv expect src=cli:p1 k=see_text text~="p5 v11c Knight_Sample local" min=1 within=30 optional=1
@p1 logout
@srv sleep 4
# viewer lists
@p2 login char="Harness Caster"
@p2 say !livestream off
@p2 hold 2
@p2 say !livestream on
@p2 hold 3
@v1 uilogin acct=@cast pw= expect=$BOTCAM
@v1 sleep 4
@v1 shot charlist_cast
@v1 uichar $BOTCAM
@v1 hold 5
@v1 shot cast_bot_view
@v1 uicheck
@v1 logout
@v2 uilogin acct=@livestream pw= expect=Harness.Caster
@v2 sleep 4
@v2 shot charlist_livestream
@v2 uichar Harness Caster
@v2 hold 3
@p2 say p5 v11c caster says hi
@p2 hold 3
@v2 shot livestream_view
@srv expect src=cli:v2 k=see_text text~="p5 v11c caster says hi" min=1 within=30
@p2 say !livestream off
@srv expect src=cli:v2 k=game_end min=1 within=40 wait=25
@p2 logout
