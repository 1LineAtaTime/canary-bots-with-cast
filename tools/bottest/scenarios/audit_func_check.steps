# SCENARIO: audit_func_check   SEED: 0   CAMERAS: auto   BOTCFG: auto
# Phase 2 deploy smoke: the /cavebot audit verbs answer on BOTH control paths (bot_commands queue
# before any camera exists, then the in-band @cast operator camera), botcfg lists the botAudit*
# keys, and a named watch + `on` makes the sink write records, then `off` stops it.
# The file itself (growth, NDJSON validity, epoch ms, cid) is checked from audit.ndjson after the run.
@srv audit status via=queue expect="enabled=off"
@srv cmd "_global" botcfg via=queue expect="(?i)botAudit"
@p1 login
@p1 goto 32369,32236,7 range=3 stuck=10
@p1 wait-see any-bot moving=1 timeout=180 as=B1
@cam:$B1 login
@srv audit status via=cam expect="enabled=off"
@srv botcfg
@srv audit kinds all via=cam
@srv audit watch "$B1" via=cam
@srv audit on via=cam expect="enabled=on"
@p1 hold 45 watch=$B1
@srv audit status via=cam expect="enabled=on"
@srv audit mark func-check-before-off via=cam
@srv audit off via=cam expect="enabled=off"
@p1 hold 10
@srv audit unwatch "$B1" via=cam
@srv audit status via=cam expect="enabled=off"
@srv expect src=srv:audit k=audit min=1 within=120
@srv expect src=srv:audit k=probe bot=$B1 min=50 within=120
@srv expect src=srv:audit k=census min=3 within=120
@srv expect src=srv:audit k=mark min=1 within=120
@cam:$B1 logout
@p1 logout
