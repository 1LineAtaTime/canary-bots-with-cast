# SCENARIO: baseline_b1_walkpause   SEED: 0   CAMERAS: none   BOTCFG: auto
# Phase 3 (lean) baseline B1 - observed walk-pause. DEBUG MODE (run after `reload debug,<5 names>`):
# the 5 named bots are PINNED (no reroll, no hibernation), every other bot is despawned. Each bot is
# teleported near the Thais temple crossing and ping-ponged with `goto` along the x=32369 street or
# the y=32215 street, through the player's view. goto sets state IDLE (walk-pause allowed).
# Server truth: audit walkpause (named watch) + state; client truth: p1 see_move gaps per bot.
# Spec: observed tier 0.5-20 s, chance 12%*wb/15 per walk issue, wb<=3 never, cap 8 per "route";
# unobserved tier 2%, 0.4-5 s, cap 3; 0 pauses outside IDLE/DWELLING/TRAVELING.
# Caveat - the per-route counters reset only in doActivityReroll, which a pinned bot never reaches,
# so each pinned bot can pause at most 8 (obs) + 3 (unobs) times for the whole session.
# Bot names: --var W1..W5.
@srv audit kinds walkpause,state,cmd,pathout,census
@srv audit watch $W1
@srv audit watch $W2
@srv audit watch $W3
@srv audit watch $W4
@srv audit watch $W5
@srv audit on expect="enabled=on"
@srv audit mark "B1 start"
@srv cmd "$W1" teleport 32369,32205,7
@srv cmd "$W2" teleport 32369,32231,7
@srv cmd "$W3" teleport 32352,32215,7
@srv cmd "$W4" teleport 32389,32214,7
@srv cmd "$W5" teleport 32369,32210,7
@p1 login
@p1 goto 32371,32218,7 range=2 stuck=15 timeout=120
@srv cmd "$W1" goto 32369,32233,7
@srv cmd "$W2" goto 32369,32203,7
@srv cmd "$W3" goto 32389,32214,7
@srv cmd "$W4" goto 32351,32215,7
@srv cmd "$W5" goto 32369,32233,7
@p1 hold 40 watch=$W1,$W2,$W3,$W4,$W5
@srv cmd "$W1" goto 32369,32203,7
@srv cmd "$W2" goto 32369,32233,7
@srv cmd "$W3" goto 32351,32215,7
@srv cmd "$W4" goto 32389,32214,7
@srv cmd "$W5" goto 32369,32203,7
@p1 hold 40 watch=$W1,$W2,$W3,$W4,$W5
@srv cmd "$W1" goto 32369,32233,7
@srv cmd "$W2" goto 32369,32203,7
@srv cmd "$W3" goto 32389,32214,7
@srv cmd "$W4" goto 32351,32215,7
@srv cmd "$W5" goto 32369,32233,7
@p1 hold 40 watch=$W1,$W2,$W3,$W4,$W5
@srv cmd "$W1" goto 32369,32203,7
@srv cmd "$W2" goto 32369,32233,7
@srv cmd "$W3" goto 32351,32215,7
@srv cmd "$W4" goto 32389,32214,7
@srv cmd "$W5" goto 32369,32203,7
@p1 hold 40 watch=$W1,$W2,$W3,$W4,$W5
@srv cmd "$W1" goto 32369,32233,7
@srv cmd "$W2" goto 32369,32203,7
@srv cmd "$W3" goto 32389,32214,7
@srv cmd "$W4" goto 32351,32215,7
@srv cmd "$W5" goto 32369,32233,7
@p1 hold 40 watch=$W1,$W2,$W3,$W4,$W5
@srv cmd "$W1" goto 32369,32203,7
@srv cmd "$W2" goto 32369,32233,7
@srv cmd "$W3" goto 32351,32215,7
@srv cmd "$W4" goto 32389,32214,7
@srv cmd "$W5" goto 32369,32203,7
@p1 hold 40 watch=$W1,$W2,$W3,$W4,$W5
@srv expect src=srv:audit k=walkpause min=1 within=600
@srv expect-none src=srv:audit k=walkpause st=HUNTING within=600
@srv expect-none src=srv:audit k=walkpause st=COMBAT within=600
@srv audit mark "B1 end"
@srv audit watch clear
@srv audit off
@p1 logout
