# SCENARIO: fix_99_fruitless_fight   SEED: 0   CAMERAS: none   BOTCFG: auto
# Fix #99 - fruitless fight. A fight in which the victim's HP has not reached a new low for 60 s is
# dropped ([FRUITLESS] drop) and the bot walks back to its pre-combat tile along a pathfinder route.
# The unkillable target is the GM character: Combat::canDoCombat refuses every hit on it
# (CannotBeAttacked), so its HP never moves, while targeting it still pz-locks the bot and keeps
# doPKAttack's "neither side pz-locked" exit from ending the fight early.
# Run: runner.py fix_99_fruitless_fight.steps --var A=<bot> --var GMCHAR=GOD --var GMACCT=@god --var GMPW=<pw>
# PRECONDITION: debug mode with $A pinned (`/cavebot reload debug,$A`).
# Acceptance: no [FRUITLESS] for A in the first ~50 s, exactly one "[FRUITLESS] drop ... kind=pk"
# for A by ~75 s, and A no longer in PK_ATTACK afterwards.
@p1 login char="$GMCHAR" acct=$GMACCT pw=$GMPW
@p1 say /town 8
@p1 hold 3
@p1 goto 32369,32215,7 range=2 stuck=15 timeout=120
@srv cmd "$A" stop
@srv cmd "$A" teleport 32365,32214,7
@srv sleep 3
@srv cmd "$A" pk $GMCHAR expect="attacking player"
@srv sleep 50
@srv expect-none src=srv msg~="\[FRUITLESS\] drop guid=[0-9]+ name='$A'"
@srv expect src=srv msg~="\[FRUITLESS\] drop guid=[0-9]+ name='$A' kind=pk target='$GMCHAR' hp=100% fightMs=[0-9]+ noProgressMs=6[0-9]{4}" min=1 max=1 wait=30
@srv sleep 3
@srv cmd "$A" status expect="(?i)state[=: ]+(IDLE|DWELLING)"
@srv cmd "$A" stop
@p1 logout
@srv expect-none src=srv msg~="Lua Script Error"
