@srv audit mark "F123 end"
@srv expect src=srv k=pvp_ignore_hitback min=1 within=900
@srv expect-none src=srv k=pvp_ignore_hitback msg~="hp=[0-9]+->(0|-)" within=900
@srv expect-none src=srv k=gang msg~="formed RAID.*Harness One" within=900
@srv expect-none src=srv msg~="Lua Script Error" within=900
@srv audit watch clear
@srv audit off
@p1 logout optional=1
