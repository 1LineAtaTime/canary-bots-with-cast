# SCENARIO: p5_human_cast   SEED: 0   CAMERAS: auto   BOTCFG: auto
# Run: runner.py p5_human_cast.steps --var CASTER="Harness One"
# Needs allowPlayerCast = true (#163; off by default, then /cast is refused: p5_human_cast_off).
# P5 (#160), both arms: our HUMAN cast (/cast, data/scripts/talkactions/player/cast.lua). The harness
# player p1 broadcasts; a second hidden client logs in as a plain viewer of p1 the way a real viewer
# does on 7172 (session key "@cast\n<password tail>", here an empty tail: watching is
# unauthenticated, and an empty tail never touches the operator lockout). The viewer's LocalPlayer
# IS p1, so its self_pos stream is p1's walk and see_self is p1's HP/mana.
# Server truth: cast_broadcasters lists p1 while casting (CastPublisher) and drops it on /cast off;
# the viewer is disconnected (game_end).
@srv audit kinds cmd,census
@p1 login
@p1 goto 32369,32220,7 range=1 stuck=10 timeout=120
@p1 say /cast off
@p1 hold 2
@p1 say /cast on
@srv db "SELECT p.name FROM cast_broadcasters c JOIN players p ON p.id = c.player_id WHERE p.name = 'Harness One'" expect="Harness One" wait=20
@cam:$CASTER login desc=@cast pw=
@cam:$CASTER perceive reset=1
@p1 hold 3
@p1 walk north 3
@p1 hold 2
@p1 walk south 3
@p1 hold 2
@p1 say p5 human cast hello
@p1 hold 2
@p1 say exura ico
@p1 hold 4
@cam:$CASTER walk-check within=40 min-steps=3
@cam:$CASTER view recent=30000
@srv expect src=cli:c1 k=see_text text~="p5 human cast hello" min=1 within=90
@srv expect src=cli:c1 k=see_effect id=13 min=1 within=90
@srv expect src=cli:c1 k=see_self min=1 within=90
@srv expect src=cli:c1 k=self_pos min=3 within=90
@p1 say /cast off
@srv expect src=cli:c1 k=game_end min=1 within=40 wait=25
@srv db "SELECT p.name FROM cast_broadcasters c JOIN players p ON p.id = c.player_id WHERE p.name = 'Harness One'" none="Harness One" wait=25
@p1 logout
