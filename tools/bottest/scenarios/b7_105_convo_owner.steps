# SCENARIO: b7_105_convo_owner   SEED: 0   CAMERAS: none   BOTCFG: auto
# #105 conversation ownership. Two pinned (task-less, IDLE) bots A and B stand next to p1 at the Thais
# depot. p1 talks: the first answer opens a thread owned by ONE bot; for the rest of the thread (30 s
# window, re-armed by each line) only that bot answers -- the other bot never jumps in -- until p1 names
# the other bot, which hands the thread over. Then p1 goes quiet past the window and the next line may be
# taken by either bot again.
# Run: runner.py b7_105_convo_owner.steps --var A=<bot> --var B=<bot>
# PRECONDITION: b7_realism_setup.steps ran (A and B debug-pinned).
# Acceptance: >= 1 "[CHAT_CONVO] own ... reason=first"; >= 3 local replies said with owner=1; ZERO local
#   replies said with owner=0 (nobody jumped in); a queued reply saw inRange >= 2 (both bots were there);
#   the named hand-over shows "[CHAT_CONVO] own bot='$B' ... reason=transfer" or B already owned it.
@srv cmd "$A" teleport 32349,32216,7
@srv cmd "$B" teleport 32350,32219,7
@p1 login
@p1 goto 32369,32215,7 range=2 stuck=15 timeout=120
@p1 goto 32351,32215,7 range=2 stuck=15 timeout=120
@p1 goto 32347,32218,7 range=1 stuck=15 timeout=120
@p1 wait-see "$A" timeout=30
@p1 wait-see "$B" timeout=30
@p1 hold 3
@p1 say hi
@p1 hold 8
@p1 say how much for a magic sword?
@p1 hold 8
@p1 say thanks
@p1 hold 8
@p1 say price of soft boots?
@p1 hold 8
@p1 say wtb mana potions
@p1 hold 8
@p1 say hey
@p1 hold 8
@srv expect src=srv msg~="\[CHAT_CONVO\] own bot=.* reason=first" min=1 within=120
@srv expect src=srv msg~="\[CHAT_REPLY\] said bot=.* pm=0 .*owner=1" min=3 within=120
@srv expect-none src=srv msg~="\[CHAT_REPLY\] said bot=.* pm=0 .*owner=0" within=120
@srv expect src=srv msg~="\[CHAT_REPLY\] queued .*inRange=[2-9]" min=1 within=120
@p1 say "$B how much for a demon shield?"
@p1 hold 8
@srv expect src=srv msg~="\[CHAT_CONVO\] own bot='$B' .*reason=(transfer|addressed)|\[CHAT_REPLY\] said bot='$B' pm=0 .*owner=1" min=1 within=15
@p1 hold 35
@p1 say hello
@p1 hold 8
@srv expect-none src=srv msg~="\[CHAT_REPLY\] said bot=.* pm=0 .*owner=0" within=200
@srv expect-none src=srv msg~="Lua Script Error" within=200
@p1 logout
