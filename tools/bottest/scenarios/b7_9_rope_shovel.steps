# SCENARIO: b7_9_rope_shovel   SEED: 0   CAMERAS: none   BOTCFG: auto
# #9 / #106 tool obstacles. The engine already uses temporary tool items (rope 3003, shovel 3457,
# machete) on rope spots, stone piles and jungle grass, from the waypoint follower (ROPE/HOLE/MACHETE
# waypoint types) and from the floor-change machine (zgraph ROPE_SPOT / SHOVEL_HOLE portals, also known
# to botnavsim). This checks the two live cases on the 15.25 map.
# Run: runner.py b7_9_rope_shovel.steps --var V=<Venore bot>
# A (#9): Venore Elves (script 402) rope spot (33056,32210,9): from (33053,32209,9) the bot must come up
#   to z8 next to the rope spot ("FC: Used rope" in the verbose log, probe at z8 within 3 tiles).
# B: Rotworm Venore Southeast (script 60) stone pile (33109,32104,7): from the tile beside it the bot
#   digs down to z8 ("FC: Used shovel", probe at z8 near the pile).
# Acceptance: both arrivals within 90 s each, both tool uses logged, zero Lua errors.
# PRECONDITION: b7_realism_setup.steps ran: the bot is debug-pinned and audited (it pins and watches all
# batch-7 realism bots at once, because reload debug and the audit settings are global).
@srv cmd "$V" "verbose on" expect="verbose"
@srv audit mark "B7-9 A: rope spot 33056,32210,9"
@srv cmd "$V" teleport 33053,32209,9
@srv sleep 3
@srv cmd "$V" goto 33059,32207,8
@srv expect src=srv:audit k=probe bot=$V pos~="x.: 330(5[3-9]|6[0-2]), .y.: 322(0[5-9]|1[0-3]), .z.: 8\}" min=1 within=90 wait=90
@srv audit mark "B7-9 B: stone pile 33109,32104,7"
@srv cmd "$V" teleport 33108,32104,7
@srv sleep 3
@srv cmd "$V" goto 33107,32096,8
@srv expect src=srv:audit k=probe bot=$V pos~="x.: 331(0[4-9]|1[0-3]), .y.: 32(09[3-9]|10[0-8]), .z.: 8\}" min=1 within=90 wait=90
@srv audit mark "B7-9 end"
@srv expect src=srv msg~="Used rope at \(33056,32210,9\)" min=1 within=300
# The 15.25 map often has this pile already OPEN (dug, not yet decayed back): then the bot just drops
# through the hole and no shovel is needed. Either way it must reach z8 through (33109,32104).
@srv expect src=srv msg~="Used shovel at \(33109,32104,7\)|PLANNED HOP OK z=7->8 at \(33109,32104,8\)" min=1 within=200
@srv expect-none src=srv msg~="Lua Script Error" within=300
