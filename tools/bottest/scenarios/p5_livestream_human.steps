# SCENARIO: p5_livestream_human   SEED: 0   CAMERAS: auto   BOTCFG: auto
# Run: runner.py p5_livestream_human.steps --var CASTER="Harness Caster"
# P5 (#160) V8, PORT ARM ONLY: upstream's native livestream (#3965, !livestream talkaction) for a
# human caster, next to our bot camera (cast C1, CAST_DECISION 5). The caster is "Harness Caster"
# (harness account, level 200 = livestreamCasterMinLevel), created ONLY in the disposable port DB.
# Viewer: session key "@livestream\n<pw tail>" on 7172 -> routeViewerLogin -> upstream
# castViewerLogin (canWatch: client, level, caps 10 / 2 per IP). Then the routing checks:
#  - "@cast" + this human goes to OUR path only with allowPlayerCast = true (#163), else upstream's;
#  - "@livestream" + a BOT name lands in the bot camera (botCameraLogin), not upstream's manager.
@p1 login char="Harness Caster"
@p1 goto 32369,32220,7 range=1 stuck=10 timeout=120
@p1 say !livestream off
@p1 hold 2
@p1 say !livestream on
@p1 hold 2
@srv db "SELECT p.name, l.livestream_status FROM active_livestream_casters l JOIN players p ON p.id = l.caster_id WHERE p.name = 'Harness Caster'" expect="Harness Caster\t1" wait=20
@cam:$CASTER login desc=@livestream pw=
@cam:$CASTER perceive reset=1
@p1 hold 3
@p1 walk north 3
@p1 hold 2
@p1 walk south 3
@p1 hold 2
@p1 say p5 livestream hello
@p1 hold 2
@p1 say exura ico
@p1 hold 4
@cam:$CASTER walk-check within=40 min-steps=3
@cam:$CASTER view recent=30000
@cam:$CASTER say p5 viewer chat
@srv expect src=cli:c1 k=see_effect id=13 min=1 within=90
@srv expect src=cli:c1 k=see_self min=1 within=90
@srv expect src=cli:c1 k=self_pos min=3 within=90
@srv expect src=cli:c1 k=see_text text~="p5 livestream hello" min=1 within=90 optional=1
@p1 say !livestream show
@p1 hold 3
@srv expect src=cli:p1 k=see_msg text~="(?i)spectator|viewer" min=1 within=30 optional=1
@p1 say !livestream off
@srv expect src=cli:c1 k=game_end min=1 within=40 wait=25
@srv db "SELECT l.livestream_status FROM active_livestream_casters l JOIN players p ON p.id = l.caster_id WHERE p.name = 'Harness Caster'" expect="^0" wait=25
# routing: @livestream + a bot name -> our bot camera
@p1 wait-see any-bot timeout=120 as=BOT
@cam:$BOT login desc=@livestream pw=
@cam:$BOT self
@srv expect src=srv msg~="\[Cast\].*$BOT" min=1 within=60 optional=1
@srv expect-none src=srv msg~="no longer broadcasting" within=300
@cam:$BOT logout
@p1 logout
