# SCENARIO: walk_observe_thais   SEED: 0   CAMERAS: none   BOTCFG: auto
# Stand in the Thais temple area for ~2 min watching two bots that are walking, then check that
# the client saw them move AND that some of those client-side steps join (same creature id,
# +-100 ms) to a server journal line about that bot (wake / ROAM / ROUTE / guid=... lines).
# No camera: the player alone is the observer.
@p1 login
@p1 goto 32369,32236,7 range=3 stuck=10
@p1 wait-see any-bot moving=1 timeout=180 as=B1
@p1 wait-see any-bot moving=1 not=$B1 timeout=120 as=B2
@p1 hold 120 watch=$B1,$B2
@p1 dump-view
@srv expect src=cli:p1 k=see_move bot=$B1 min=1 within=140
@srv expect src=cli:p1 k=see_move bot=$B2 min=1 within=140
@srv expect join=move cli=p1 bot=any min=1 within=140 window=100
@srv expect-none src=srv msg~="Lua Script Error" within=200
@p1 logout
