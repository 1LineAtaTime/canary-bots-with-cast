# SCENARIO: fix_118_route_closed_on_arrival   SEED: 0   CAMERAS: none   BOTCFG: auto
# Fix #118 - a multi-floor (ZLEG) route is closed with its clocks when it ends, so the NEXT goto does
# not inherit the previous route's per-waypoint timer and skip its first waypoint as "stuck".
# PRECONDITION: debug mode with the bot pinned: `/cavebot reload debug,$R`.
# Run: runner.py fix_118_route_closed_on_arrival.steps --var R=<name>   (baseline bot: Kaelis Duke)
# Replays baseline B5 G3..G6 from the Thais temple: stairs z6 -> boat ladder z6 -> depot cellar z8 ->
# north gate. Baseline (2026-11-18): the goto right after each multi-floor arrival logged
#   pathout outcome=stuck route=ZLEG wp=0 reason=wp-skip-timeout val=120849 / 121823
# (= time since the previous arrival), then `arrived` in the same millisecond: 3 of 3 stuck records.
# Acceptance (server truth, audit pathout for the named bot):
#   - zero `stuck` records with reason=wp-skip-timeout and val >= 60000 ms. No live leg can reach
#     that: a ZLEG under the FC machine skips at 15 s, a planner leg at 15 s + 0.4 s/tile, and both
#     now restart their clock whenever the bot gets closer;
#   - each goal is still reached: a probe record (pos every botAuditProbeMs) within Chebyshev 1 of
#     each goal on the goal floor (Chebyshev 3 for the north gate, which baseline B5 also reached
#     only at 3: its tile is the gate itself). (pathout `arrived` is NOT used: a leg finished by the FC machine
#     never reaches followWaypoints' completion, so arrivals are not one record per goal.)
@srv audit kinds probe,path,pathout,state,cmd
@srv audit watch $R
@srv audit on expect="enabled=on"
@srv cmd "$R" teleport 32369,32237,7
@srv sleep 3
@srv audit mark "F118 G3 ammo-z6 32345,32246,6"
@srv cmd "$R" goto 32345,32246,6
@srv sleep 100
@srv audit mark "F118 G4 boat-ladder-z6 32310,32211,6"
@srv cmd "$R" goto 32310,32211,6
@srv sleep 100
@srv audit mark "F118 G5 depot-cellar-z8 32346,32231,8"
@srv cmd "$R" goto 32346,32231,8
@srv sleep 100
@srv audit mark "F118 G6 north-gate 32369,32183,7"
@srv cmd "$R" goto 32369,32183,7
@srv sleep 90
@srv audit mark "F118 end"
@srv expect-none src=srv:audit k=pathout bot=$R outcome=stuck reason=wp-skip-timeout val~="^([6-9][0-9]{4}|[0-9]{6,})$" within=420
@srv expect src=srv:audit k=probe bot=$R pos~="x.: 3234[4-6], .y.: 3224[5-7], .z.: 6\}" min=1 within=420
@srv expect src=srv:audit k=probe bot=$R pos~="x.: 323(09|10|11), .y.: 3221[0-2], .z.: 6\}" min=1 within=420
@srv expect src=srv:audit k=probe bot=$R pos~="x.: 3234[5-7], .y.: 3223[0-2], .z.: 8\}" min=1 within=420
@srv expect src=srv:audit k=probe bot=$R pos~="x.: 323(6[6-9]|7[0-2]), .y.: 3218[0-6], .z.: 7\}" min=1 within=420
@srv expect-none src=srv msg~="Lua Script Error" within=420
@srv audit watch clear
@srv audit off
