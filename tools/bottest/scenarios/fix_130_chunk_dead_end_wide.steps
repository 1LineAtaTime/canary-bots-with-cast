# SCENARIO: fix_130_chunk_dead_end_wide   SEED: 0   CAMERAS: none   BOTCFG: auto
# Fix #130 - the FC machine's planned-hop leg (ZLEG) escalates a failed waypoint walk to ONE bounded
# wide search (goToWide: 4096 nodes, PATH_WIDE_DIST, 1 per bot per 15 s), like planScopedWalk's own
# ZLEG already did; and a cross-floor planner walk waits (<= 12 s, the #116 wait) on a "not yet"
# z-plan instead of handing the target to the greedy nearest-transition scan.
# Baseline (batch 1, runs/b1_b5 B5 G3): from (32390,32223,7) every 512-node chunk search toward the
# stairs (32350,32246,7) failed (69 `path planner=astar result=fail`, 0 `wide`), the leg timed out
# 3 x 15 s (`pathout stuck route=ZLEG reason=wp-skip-timeout`), the stair was quarantined
# (`[ZBLACKLIST] portal=(32350,32246,7) site=zleg`) and the bot climbed the ladder at
# (32383,32231,7) into an 11-tile z6 pocket at (32382,32231,6), where it stayed.
# Offline (botnavsim, Thais dump navdump_32300_32190_4.bin): `walk --from 32390,32223,7 --to
# 32350,32246,7 --nodes 1 --wide` = ONE wide search, 91 tiles south around the block, no door.
# Run: runner.py fix_130_chunk_dead_end_wide.steps --var R=<Thais bot>   (baseline bot: Kaelis Duke)
# PRECONDITION: debug mode with the bot pinned: `/cavebot reload debug,$R`.
# Two starts: (A) the real G3 start, the end of G2 at the potions shop (32399,32216,7); (B) the
# dead-end tile itself. Acceptance (server truth, each run):
#   - at least one audit `path planner=wide result=ok` toward the stairs (32350,32246,7) -- the
#     escalation ran and found the route. (If the jitter walk happens not to dead-end, A may
#     legitimately need none; B starts in the dead end, so B must show it);
#   - zero `pathout stuck route=ZLEG reason=wp-skip-timeout` and zero `[ZBLACKLIST] ... site=zleg`;
#   - the bot reaches z6 within Chebyshev 1 of the goal (a probe there) and is never probed in the
#     wrong z6 pocket around (32382,32231,6).
#   - "[WIDE] 60s" (review F1, always on) is logged, counts the searches, and maxPerTick <= 2.
# Baseline replay (replay.py on runs/b1_b5): FAILS the wide, stuck, blacklist, goal and pocket checks.
@srv audit kinds probe,path,pathout,state,cmd
@srv audit watch $R
@srv audit on expect="enabled=on"
@srv audit mark "F130 A: G3 from the potions shop 32399,32216,7"
@srv cmd "$R" teleport 32399,32216,7
@srv sleep 3
@srv cmd "$R" goto 32345,32246,6
@srv sleep 100
@srv expect-none src=srv:audit k=pathout bot=$R outcome=stuck route=ZLEG reason=wp-skip-timeout within=105
@srv expect src=srv:audit k=probe bot=$R pos~="x.: 3234[4-6], .y.: 3224[5-7], .z.: 6\}" min=1 within=105
@srv audit mark "F130 B: start in the dead end 32390,32223,7"
@srv cmd "$R" teleport 32390,32223,7
@srv sleep 3
@srv cmd "$R" goto 32345,32246,6
@srv sleep 100
@srv audit mark "F130 end"
@srv expect src=srv:audit k=path bot=$R planner=wide result=ok dst~="^.32350, 32246, 7.$" min=1 within=105
@srv expect-none src=srv:audit k=pathout bot=$R outcome=stuck route=ZLEG reason=wp-skip-timeout within=105
@srv expect src=srv:audit k=probe bot=$R pos~="x.: 3234[4-6], .y.: 3224[5-7], .z.: 6\}" min=1 within=105
@srv expect-none src=srv k=zblacklist msg~="portal=.32350,32246,7. site=zleg" within=220
@srv expect-none src=srv:audit k=probe bot=$R pos~="x.: 3238[0-4], .y.: 3223[0-3], .z.: 6\}" within=220
# Review F1: goToWide's always-on cost line. It must exist (the 60 s block ran on this build), the
# per-tick cap must hold (maxPerTick <= 2), and the searches that ran here must show up in it.
@srv expect src=srv k=wide msg~="60s runs=[0-9]+ ok=[0-9]+ fcLeg=[0-9]+ msP50=" min=1 within=220
@srv expect src=srv k=wide msg~="60s runs=[1-9][0-9]* ok=[1-9]" min=1 within=220
@srv expect-none src=srv k=wide msg~="maxPerTick=([3-9]|[1-9][0-9]+) " within=220
@srv expect-none src=srv msg~="Lua Script Error" within=220
@srv audit watch clear
@srv audit off
