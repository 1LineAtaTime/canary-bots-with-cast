# SCENARIO: fix_30_spawn_autoclaim   SEED: 0   CAMERAS: none   BOTCFG: auto
# Fix #30 - passive spawn auto-claim (bot_learning.cpp). A real player who stays inside a #29 spawn
# group's area for botSpawnAutoClaimDwellSec (60) claims it implicitly: an autoClaim row in
# playerClaims_, which every live/virtual/party pick gate already honours by spawnGroup. Bots already
# hunting the group are sent out (PATROLLING -> LEAVING). Logout / leaving / idling releases it.
# PRECONDITION: char `Harness Learn` (account harnessacct, lv200) stored at 32431,32321,8 = patrol
# waypoint 2 of Wasp Cave Thais Spear (script 77), outside any town. $R = any bot (pinned here).
# Acceptance: claim with evicted=1 and the bot evicted from PATROLLING; no other bot is assigned
# script 77 while the claim holds; the claim is released (reason=offline) after logout.
@srv cmd "$R" probe on
@srv cmd "$R" huntpatrol 77 expect="patrolling 'Wasp Cave Thais Spear' \(script=77"
@srv sleep 10
@p1 login char="Harness Learn"
@p1 hold 100
@srv expect src=srv msg~="\[SPAWN_CLAIM\] auto claim player='Harness Learn' guid=[0-9]+ group=.+ script=77 'Wasp Cave Thais Spear' dwell=[0-9]+s fight=[0-9]+s evicted=1" min=1 max=1 within=115
@srv expect src=srv msg~="\[SPAWN_CLAIM\] auto evict bot='$R' guid=[0-9]+ group=.+ phase=PATROLLING live=1 owner='Harness Learn'" min=1 within=115
@srv cmd _global listclaims expect="Wasp Cave Thais Spear' -> Harness Learn \(~[0-9]+ min left\) auto group="
@srv cmd "$R" status
@p1 walk north 1 optional=1
@p1 hold 120
@srv cmd _global listclaims expect="-> Harness Learn \(~[0-9]+ min left\) auto group="
@srv expect-none src=srv msg~="\[HuntAssign\] (?!$R ).*\(id=77 " within=230
@p1 logout
@srv expect src=srv msg~="\[SPAWN_CLAIM\] auto release player='Harness Learn' guid=[0-9]+ group=.+ reason=offline held=[0-9]+s" min=1 wait=20
@srv cmd _global listclaims expect="^(?![\s\S]*Harness Learn)"
@srv expect-none src=srv msg~="Lua Script Error" within=420
@srv cmd "$R" probe off
