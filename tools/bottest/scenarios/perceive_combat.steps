# SCENARIO: perceive_combat   SEED: 0   CAMERAS: auto   BOTCFG: auto
# A hidden client perceiving a real fight. `find-bot` picks (read-only, journal) a bot whose latest
# hunt-phase transition entered PATROLLING; an @cast camera on it is an observer, so the bot wakes
# at its spawn and fights real monsters, and the camera client receives exactly the packets that
# bot's own client would (sendMagicEffect / sendDistanceShoot / sendTextMessage / sendCreatureHealth
# / sendSpellCooldown are all forwarded to cast viewers, player.cpp). The player p1 stays in the
# Thais temple and perceives town life (bot spells, login sparkles, speech) meanwhile.
# Missiles need a distance fighter or a ranged monster, so they are optional.
@p1 login
@p1 goto 32367,32240,7 range=2 stuck=10
@srv find-bot since=1500 as=HB
@cam:$HB login
@srv cmd "$HB" status expect="state="
@cam:$HB perceive reset=1
@cam:$HB hold 100 watch=$HB
@cam:$HB view recent=5000
@srv cmd "$HB" status expect="state="
@cam:$HB perceive
@p1 view
@p1 perceive
@srv expect src=cli:c1 k=see_effect min=1
@srv expect src=cli:c1 k=see_text kind=anim min=1
@srv expect src=cli:c1 k=see_creature changed~="hp" min=1
@srv expect src=cli:c1 k=see_msg min=1 optional=1
@srv expect src=cli:c1 k=see_missile min=1 optional=1
@srv expect src=cli:p1 k=see_effect min=1 optional=1
@srv expect-none src=cli:* k=tap_error
@cam:$HB logout
@p1 logout
