# SCENARIO: hidden_parity   SEED: 0   CAMERAS: auto   BOTCFG: off
# Exercises every client verb once, plus camera login, in-band /cavebot and /lagmark latency, so
# the same file can be run hidden (default) and with --visible and the run dirs compared.
# window-state reports the Win32 visible flag of each client (run.log shows hidden vs visible).
# Steps that the Thais temple crowd can legitimately block are optional=1.
@p1 login
@p1 window-state
@p1 goto 32367,32240,7 range=2 stuck=10
@p1 face s
@p1 walk e 1 optional=1
@p1 walk w 1 optional=1
@p1 stop
@p1 dump-view
@p1 wait-see any-bot timeout=180 as=BOT
@p1 say hi
@p1 shot window
@p1 shot map mode=map
@p1 shot reveal reveal=1
@p1 set-fps 10
@cam:$BOT login
@cam:$BOT window-state
@srv cmd "$BOT" status expect="state="
@srv cmd "$BOT" status
@srv cmd "$BOT" status
@cam:$BOT lagmark 30
@cam:$BOT shot cam_map mode=map
@p1 follow $BOT optional=1
@p1 stop
@p1 pm $BOT hello
@p1 wait-gone "Nobody Fakename-Harness" timeout=2
@p1 hold 20 watch=$BOT
@srv expect src=cli:p1 k=see_appear bot=$BOT min=1
@cam:$BOT logout
@p1 logout
