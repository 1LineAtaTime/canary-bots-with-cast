# SCENARIO: b7_control_panel   SEED: 0   CAMERAS: none   BOTCFG: auto
# #26/#94: the OTClient bot-control panel (mods/game_botcontrol, installed into the harness client
# by setup_client.py --mod-only) over ExtendedOpcode 120. The panel opens, lists the party bots with
# their state, and its buttons send verbs that change what the bots do.
# Server truth: [BOT_VERB] ... src=opcode ... (bot_verb.cpp). Client truth: the panel dump
# (modules.game_botcontrol.dump(): visible, header, rows, last result) + screenshots.
@p1 login
@p1 goto 32369,32215,7 range=2 stuck=15 timeout=120
@p1 wait-see any-bot timeout=180 as=S1
@p1 botpanel open expect="visible=true"
@p1 botpanel dump expect="rows=[1-9]" timeout=15
@p1 shot panel_nearby reveal=1
@p1 pm $S1 summon ek,ed [1,3000] teleport
@srv expect src=srv msg~="\[BOT_VERB\] from='Harness One' src=pm verb=summon .*result=ok" min=1 within=60
@p1 hold 6
# both summoned bots (ek + ed) must be in the party before the buttons are tested (each verb expects 2 replies)
@p1 botpanel dump expect="2 bot\(s\) in party" timeout=90
@p1 shot panel_party reveal=1
# Stay button: the bots hold while the leader walks away
@p1 botpanel click stay expect="Holding here" timeout=10
@srv expect src=srv msg~="\[BOT_VERB\] from='Harness One' src=opcode verb=stay .*result=ok" min=2 within=20
@p1 goto 32362,32215,7 range=0 stuck=15 timeout=60
@p1 hold 6
@srv expect src=srv msg~="\[BOT_VERB\] apply bot='.*' mode=stay .*leaderDist=([4-9]|1[0-9])" min=1 within=10
@p1 botpanel dump expect="stay" timeout=10
@p1 shot panel_after_stay reveal=1
# Follow button: back to the default
@p1 botpanel click follow expect="Right behind you" timeout=10
@srv expect src=srv msg~="src=opcode verb=follow .*result=ok" min=2 within=20
# Heal me button: addressed to the druids only
@p1 botpanel click heal expect="(Exura sio|next)" timeout=10
@srv expect src=srv msg~="src=opcode verb=heal .*result=ok:(cast|queued)" min=1 within=20
@p1 shot panel_after_heal reveal=1
@p1 botpanel close expect="visible=false"
@srv expect-none src=srv msg~="Lua Script Error" within=600
@p1 party leave
@p1 logout
