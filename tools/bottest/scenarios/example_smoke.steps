# SCENARIO: example_smoke   SEED: 0   CAMERAS: auto   BOTCFG: auto
# Smoke test: log the harness player in, walk next to the Thais temple, wait until any bot is
# on screen, put an @cast operator camera on that bot, ask the engine about it in-band, log out.
# A camera IS an observer: it wakes / un-hibernates the bot it watches.
@p1 login
@p1 goto 32367,32240,7 range=2 stuck=10
@p1 dump-view
@p1 wait-see any-bot timeout=180 as=BOT
@p1 shot temple
@cam:$BOT login
@srv cmd "$BOT" status expect="state="
@srv expect src=cli:p1 k=see_appear bot=$BOT min=1
@srv expect src=cli:c1 k=see_msg text~="Bot '$BOT'" min=1
@cam:$BOT logout
@p1 logout
