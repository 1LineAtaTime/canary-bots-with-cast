# SCENARIO: fix_96_danger_zones   SEED: 0   CAMERAS: none   BOTCFG: auto
# Fix #96 - learned hunt-danger zones (bot_learning.cpp). A death while working a hunt records a
# zone (radius 14, +45) keyed by script, persisted async to bot_hunt_danger; at score >= 60 or
# deaths >= 2 the script turns party-only (solo picks skip it, party formation tries it first),
# and solo bots skip patrol nodes / targets inside the zone.
# PRECONDITION: bot_hunt_danger exists (database/bots/25_bot_hunt_danger.sql). $D, $E = two bots.
# Script 399 Thais Paw Collector (surface wolves/bears, 72 patrol waypoints).
# Acceptance: two forced deaths -> score 45 then 90 / deaths 2 / established=1; no bag for a death
# without a player killer (#107); a next bot on 399 skips the zone's waypoints.
@srv cmd _global danger clear 399
@srv cmd "$D" probe on
@srv cmd "$D" huntpatrol 399 expect="patrolling 'Thais Paw Collector' \(script=399"
@srv sleep 8
@srv cmd "$D" testdie expect="testdie at \([0-9]+,[0-9]+,7\) script=399 phase=PATROLLING"
@srv expect src=srv msg~="\[DANGER\] record kind=death why=death script=399 'Thais Paw Collector' bot='$D' party=1 pos=\([0-9]+,[0-9]+,7\) center=\([0-9]+,[0-9]+,7\) radius=14 score=45 deaths=1 near=0 minParty=2 established=0" min=1 wait=15
@srv expect src=srv msg~="\[BOT_DEATH_DROP\] skip victim=$D killer=(none|creature:[^=]+) reason=not_real_player" min=1 wait=10
# let the death re-login (back at the temple) happen BEFORE the second huntpatrol, not after it
@srv sleep 45
@srv cmd "$D" huntpatrol 399 expect="patrolling 'Thais Paw Collector'"
@srv sleep 8
@srv cmd "$D" testdie expect="testdie at"
@srv expect src=srv msg~="\[DANGER\] record kind=death why=death script=399 'Thais Paw Collector' bot='$D' party=1 .* radius=14 score=90 deaths=2 near=0 minParty=2 established=1" min=1 wait=15
@srv cmd _global danger check 399 expect="party_only=1 solo_wps_in_zone=[1-9][0-9]*/72"
@srv cmd _global danger expect="script=399 center=\([0-9]+,[0-9]+,7\) r=14 score=90 deaths=2 near=0 minParty=2 ttl=16[78]h party_only=1"
@srv cmd "$E" probe on
@srv cmd "$E" huntpatrol 399 expect="patrolling 'Thais Paw Collector'"
@srv expect src=srv msg~="\[DANGER\] avoid kind=wp bot='$E' script=399 virtual=0 skip=1\.\.[0-9]+ of 72" min=1 wait=150
@srv cmd "$E" status
@srv sleep 70
@srv expect src=srv msg~="\[DANGER\] summary zones=[1-9][0-9]* scripts=[1-9][0-9]* avoid target=[0-9]+ wp=[1-9][0-9]* pick=[0-9]+ convert=[0-9]+" min=1 within=120
@srv expect-none src=srv msg~="Lua Script Error" within=400
@srv cmd "$E" stop
@srv cmd "$E" probe off
@srv cmd "$D" probe off
