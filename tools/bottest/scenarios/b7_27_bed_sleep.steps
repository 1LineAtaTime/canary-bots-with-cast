# SCENARIO: b7_27_bed_sleep   SEED: 0   CAMERAS: none   BOTCFG: auto
# #27 bed sleep. A pinned bot walks into a bot-owned house on its floor that has a free bed, lies down
# (stock BedItem::sleep, bot branch: no client logout), hibernates ON the bed, and the bed shows it as
# the sleeper. A GM teleports next to the bed and looks: no bot body, the bed sprite is the occupied one
# (bedItem differs from the free one, bedSleeper = the bot's guid). The sleep then ends through its own
# timer (`bed timer 15`) and the bot wakes ON the bed in front of the GM (see_appear), the bed is free again.
# Run: runner.py b7_27_bed_sleep.steps --var BOT=<bot in a town with bot houses> --var GODPW=<god pw>
# Acceptance: [BED_SLEEP] start + asleep onBed=1; status hibernated=1 bedSleeper=<guid>; no see_appear of
# the bot while asleep (proximity wakes refused); [BED_SLEEP] wake path=wake; GM see_appear of the bot;
# status "not sleeping" afterwards; zero Lua errors. Screenshots bed_asleep / bed_awake for the eye.
# PRECONDITION: b7_realism_setup.steps ran: the bot is debug-pinned and audited (it pins and watches all
# batch-7 realism bots at once, because reload debug and the audit settings are global).
@srv cmd "$BOT" teleport 32369,32237,7
@srv sleep 3
@srv cmd "$BOT" bed expect="mode=bed" capture="STAND:mode=bed\s*->\s*\((\d+,\d+,\d+)\)"
@srv expect src=srv msg~="\[BED_SLEEP\] start bot='$BOT'" min=1 within=240 wait=240
@srv expect src=srv msg~="\[BED_SLEEP\] asleep bot='$BOT'.*onBed=1" min=1 within=60 wait=20
@srv cmd "$BOT" "bed status" expect="hibernated=1 bedItem=[0-9]+ bedSleeper=[1-9]"
@p1 login char="GOD" acct=@god pw=$GODPW
@p1 say "/pos $STAND"
@p1 hold 8
@p1 shot bed_asleep mode=map
@srv cmd "$BOT" "bed status" expect="hibernated=1"
@srv expect-none src=cli:p1 k=see_appear bot=$BOT within=10
@srv cmd "$BOT" "bed timer 10" expect="wakes in"
@srv expect src=srv msg~="\[BED_SLEEP\] wake bot='$BOT' path=wake slept=[0-9]+s bedCleared=1" min=1 within=60 wait=40
@srv expect src=cli:p1 k=see_appear bot=$BOT min=1 within=60 wait=10
@p1 hold 3
@p1 shot bed_awake mode=map
@srv cmd "$BOT" "bed status" expect="not sleeping"
@srv expect-none src=srv msg~="Lua Script Error" within=400
@p1 logout
