@srv audit mark "F120 end"
@srv expect src=srv:audit k=walkpause tier=observed min=1 within=700
@srv expect src=srv:audit k=walkpause tier=observed at=midwalk min=1 within=700
@srv expect-none src=srv:audit k=walkpause st~="HUNTING|COMBAT|PK_ATTACK|FLEEING" within=700
@srv expect-none src=srv msg~="Lua Script Error" within=700
@srv audit watch clear
@srv audit off
@p1 logout
