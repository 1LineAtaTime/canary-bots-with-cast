# SCENARIO: fix_107_death_drop   SEED: 0   CAMERAS: none   BOTCFG: auto
# Fix #107 - a bot killed by a REAL player drops a small level-scaled bag (loot table:
# data/scripts/lib/bot_death_drop.lua, rolled in bot_death.lua's onDeath). Killed by a monster or
# by another bot: nothing, and a [BOT_DEATH_DROP] skip line says why.
# PRECONDITION: char `Harness Learn2` (account harnessacct, lv200, skill_fist 150: a naked knight with
# fist 10 is fully blocked by a bot's shield) stored at 32406,32160,7 (road north-east of
# Thais, no PZ). $V, $B, $M = low-level bots (above protectionLevel); $K = a high-level bot.
# Victims are frozen with `aipause on` (a fleeing bot outruns a naked knight's fists), and the
# player's victim is set to 5 HP so the first hit kills it before a passing bot can.
# Acceptance: one bag with platinum coins for the player kill; skip lines for the bot kill
# (killer=bot:) and the monster kill (killer=creature:); no bag line for either; no Lua errors.
@p1 login char="Harness Learn2"
@srv cmd "$V" probe on
@srv cmd "$V" teleport 32407,32160,7
@srv cmd "$V" aipause on expect="paused"
@srv cmd "$V" testhp 5 expect="health set to 5/"
@srv sleep 3
@p1 attack $V
@srv expect src=srv msg~="\[BOT_DEATH_DROP\] killer=Harness Learn2 victim=$V level=[0-9]+ where=(corpse|tile) items=3035x[0-9]+" min=1 wait=150
@p1 attack stop
@srv cmd "$V" aipause off
@srv cmd "$B" probe on
@srv cmd "$K" probe on
@srv cmd "$B" teleport 32416,32150,7
@srv cmd "$B" aipause on expect="paused"
@srv cmd "$K" teleport 32417,32150,7
@srv sleep 2
@srv cmd "$K" pk $B expect="attacking player"
@srv expect src=srv msg~="\[BOT_DEATH_DROP\] skip victim=$B killer=bot:$K reason=not_real_player" min=1 wait=300
@srv cmd "$B" aipause off
@srv cmd "$M" probe on
@srv cmd "$M" teleport 32091,32167,7
@srv cmd "$M" aipause on expect="paused"
@srv cmd "$M" testmonster dragon lord expect="Spawned"
@srv cmd "$M" testmonster dragon lord expect="Spawned"
@srv expect src=srv msg~="\[BOT_DEATH_DROP\] skip victim=$M killer=creature:.* reason=not_real_player" min=1 wait=150
@srv cmd "$M" aipause off
@srv expect-none src=srv msg~="\[BOT_DEATH_DROP\] killer=.* victim=($B|$M) " within=500
@srv expect-none src=srv msg~="Lua Script Error|\[BOT_DEATH_DROP\] error" within=600
@p1 logout
@srv cmd "$K" stop
@srv cmd "$V" probe off
@srv cmd "$B" probe off
@srv cmd "$K" probe off
@srv cmd "$M" probe off
